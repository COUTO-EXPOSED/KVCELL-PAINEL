PORT=80
ADMIN_EMAIL=admin@kvcell.local
ADMIN_PASSWORD=troque-esta-senha
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Persistência Square Cloud Blob (SQLite criptografado)
SQUARE_BLOB_API_KEY=
SQUARE_BLOB_ACCOUNT_ID=
SQUARE_BLOB_DB_NAME=kvcell_database
SQUARE_BLOB_PREFIX=kvcell
# opcional: URL pública exata do objeto persistente
SQUARE_BLOB_PUBLIC_URL=
# gere uma Fernet key e mantenha somente nas variáveis do Square Cloud
KVCELL_DB_ENCRYPTION_KEY=
